// Dotnapps CRM — Prisma schema
// Phase 1: Foundation (auth, organizations, users, memberships, roles, audit).
//
// Design rules carried from the product spec:
//   - Every organization-owned record carries `orgId` (tenant scope).
//   - Authorization is enforced in application code (server-side RBAC); the
//     schema only provides the data to enforce it.
//   - Important mutations are recorded in AuditLog.
//   - Model stays modular so CRM Core (Lead, Contact, Company, Deal, ...)
//     and later phases attach without reshaping Foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Platform-level staff flag for the Super Admin area. Distinct from
  // per-organization roles below.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  createdOrgs Organization[] @relation("OrganizationCreatedBy")
  sentInvites Invite[]       @relation("InviteInvitedBy")
  auditLogs   AuditLog[]     @relation("AuditLogActor")

  // CRM ownership (Phase 2)
  ownedLeads     Lead[]    @relation("LeadOwner")
  ownedContacts  Contact[] @relation("ContactOwner")
  ownedCompanies Company[] @relation("CompanyOwner")

  // Sales (Phase 3)
  ownedDeals    Deal[]     @relation("DealOwner")
  assignedTasks Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreatedBy")
  activities    Activity[] @relation("ActivityCreatedBy")

  @@index([email])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdById String
  createdBy   User     @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  auditLogs   AuditLog[]

  // CRM Core (Phase 2)
  leads     Lead[]
  contacts  Contact[]
  companies Company[]
  addresses Address[]
  tags      Tag[]

  // Sales (Phase 3)
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  tasks          Task[]
  activities     Activity[]

  @@index([slug])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invite {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InviteInvitedBy", fields: [invitedById], references: [id])

  @@unique([orgId, email])
  @@index([orgId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  // orgId is null for platform-level events (e.g. user registration before
  // any organization exists).
  orgId      String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// CRM Core (Phase 2): Leads, Contacts, Companies, Addresses, Tags, Notes.
//   - Read access is org-wide for every role in V1; create/edit/delete/assign
//     /archive/export are gated by RBAC permissions in application code.
//   - Records are archived, never hard-deleted, once they carry history.
// ---------------------------------------------------------------------------

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  REFERRAL
  COLD_CALL
  EMAIL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  UNQUALIFIED
}

enum AddressKind {
  BILLING
  SHIPPING
  OTHER
}

model Company {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  website   String?
  industry  String?
  size      String?
  gstin     String?
  ownerId   String?
  notes     String?  @db.Text
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts           Contact[]
  addresses          Address[]
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  tags               Tag[]        @relation("CompanyTags")
  convertedFromLeads Lead[]       @relation("LeadConvertedCompany")

  @@index([orgId, archived])
  @@index([orgId, ownerId])
  @@index([orgId, name])
}

model Address {
  id         String      @id @default(cuid())
  orgId      String
  companyId  String
  kind       AddressKind @default(OTHER)
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orgId])
}

model Contact {
  id        String      @id @default(cuid())
  orgId     String
  name      String
  title     String?
  email     String?
  phone     String?
  whatsapp  String?
  companyId String?
  source    LeadSource?
  ownerId   String?
  notes     String?     @db.Text
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company            Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  tags               Tag[]        @relation("ContactTags")
  convertedFromLeads Lead[]       @relation("LeadConvertedContact")

  @@index([orgId, archived])
  @@index([orgId, ownerId])
  @@index([orgId, email])
  @@index([companyId])
}

model Lead {
  id             String     @id @default(cuid())
  orgId          String
  name           String
  companyName    String?
  email          String?
  phone          String?
  whatsapp       String?
  website        String?
  source         LeadSource @default(MANUAL)
  industry       String?
  location       String?
  ownerId        String?
  status         LeadStatus @default(NEW)
  estimatedValue Decimal?   @db.Decimal(14, 2)
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  archived       Boolean    @default(false)

  convertedAt        DateTime?
  convertedContactId String?
  convertedCompanyId String?
  convertedDealId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner            User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedContact Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedCompany Company?     @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedDeal    Deal?        @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  tasks            Task[]
  activities       Activity[]
  tags             Tag[]        @relation("LeadTags")

  @@index([orgId, archived])
  @@index([orgId, status])
  @@index([orgId, ownerId])
  @@index([orgId, createdAt])
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads     Lead[]       @relation("LeadTags")
  contacts  Contact[]    @relation("ContactTags")
  companies Company[]    @relation("CompanyTags")
  deals     Deal[]       @relation("DealTags")

  @@unique([orgId, name])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Sales Pipeline (Phase 3): Pipeline, PipelineStage, Deal, Task, Activity.
//   - Activity is the single timeline primitive. A NOTE-type activity with
//     source MANUAL is a hand-written note; SYSTEM activities record stage
//     changes, task completions, conversions, etc.
//   - Deal.status is denormalised from its stage's kind for fast filtering.
// ---------------------------------------------------------------------------

enum StageKind {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  FOLLOW_UP
  DEMO
  NOTE
  TASK
}

enum ActivitySource {
  MANUAL
  SYSTEM
}

model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@index([orgId, archived])
}

model PipelineStage {
  id          String    @id @default(cuid())
  orgId       String
  pipelineId  String
  name        String
  position    Int
  probability Int       @default(0)
  kind        StageKind @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@index([orgId])
}

model Deal {
  id                String      @id @default(cuid())
  orgId             String
  name              String
  pipelineId        String
  stageId           String
  status            DealStatus  @default(OPEN)
  companyId         String?
  contactId         String?
  ownerId           String?
  value             Decimal?    @db.Decimal(14, 2)
  currency          String      @default("USD")
  probability       Int?
  source            LeadSource?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  winReason         String?
  lossReason        String?
  archived          Boolean     @default(false)
  lastActivityAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  activities Activity[]
  tags       Tag[]         @relation("DealTags")
  fromLeads  Lead[]        @relation("LeadConvertedDeal")

  @@index([orgId, archived])
  @@index([orgId, status])
  @@index([orgId, ownerId])
  @@index([pipelineId, stageId])
  @@index([orgId, expectedCloseDate])
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdById String?
  leadId      String?
  contactId   String?
  companyId   String?
  dealId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee  User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, assigneeId, status])
  @@index([orgId, dueAt])
  @@index([dealId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
}

model Activity {
  id          String         @id @default(cuid())
  orgId       String
  type        ActivityType
  source      ActivitySource @default(MANUAL)
  subject     String?
  body        String?        @db.Text
  occurredAt  DateTime       @default(now())
  createdById String?
  leadId      String?
  contactId   String?
  companyId   String?
  dealId      String?
  createdAt   DateTime       @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
}

