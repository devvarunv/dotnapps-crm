// Dotnapps CRM — Prisma schema
// Phase 1: Foundation (auth, organizations, users, memberships, roles, audit).
//
// Design rules carried from the product spec:
//   - Every organization-owned record carries `orgId` (tenant scope).
//   - Authorization is enforced in application code (server-side RBAC); the
//     schema only provides the data to enforce it.
//   - Important mutations are recorded in AuditLog.
//   - Model stays modular so CRM Core (Lead, Contact, Company, Deal, ...)
//     and later phases attach without reshaping Foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Platform-level staff flag for the Super Admin area. Distinct from
  // per-organization roles below.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  createdOrgs Organization[] @relation("OrganizationCreatedBy")
  sentInvites Invite[]       @relation("InviteInvitedBy")
  auditLogs   AuditLog[]     @relation("AuditLogActor")

  // CRM ownership (Phase 2)
  ownedLeads     Lead[]    @relation("LeadOwner")
  ownedContacts  Contact[] @relation("ContactOwner")
  ownedCompanies Company[] @relation("CompanyOwner")

  // Sales (Phase 3)
  ownedDeals    Deal[]     @relation("DealOwner")
  assignedTasks Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreatedBy")
  activities    Activity[] @relation("ActivityCreatedBy")

  // Automation & notifications (Phase 5)
  createdRules      ReminderRule[]           @relation("RuleCreatedBy")
  notifications     Notification[]           @relation("UserNotifications")
  notificationPrefs NotificationPreference[] @relation("UserNotificationPrefs")

  @@index([email])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdById String
  createdBy   User     @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  auditLogs   AuditLog[]

  // CRM Core (Phase 2)
  leads     Lead[]
  contacts  Contact[]
  companies Company[]
  addresses Address[]
  tags      Tag[]

  // Sales (Phase 3)
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  tasks          Task[]
  activities     Activity[]

  // Revenue integration (Phase 4)
  integrations      Integration[]
  quotationLinks    QuotationLink[]
  invoiceLinks      InvoiceLink[]
  paymentEvents     PaymentEvent[]
  integrationEvents IntegrationEvent[]

  // Automation & notifications (Phase 5)
  reminderRules           ReminderRule[]
  reminderExecutions      ReminderExecution[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // Billing (Phase 7)
  subscription Subscription?
  usageRecords UsageRecord[]

  @@index([slug])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invite {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InviteInvitedBy", fields: [invitedById], references: [id])

  @@unique([orgId, email])
  @@index([orgId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  // orgId is null for platform-level events (e.g. user registration before
  // any organization exists).
  orgId      String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// CRM Core (Phase 2): Leads, Contacts, Companies, Addresses, Tags, Notes.
//   - Read access is org-wide for every role in V1; create/edit/delete/assign
//     /archive/export are gated by RBAC permissions in application code.
//   - Records are archived, never hard-deleted, once they carry history.
// ---------------------------------------------------------------------------

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  REFERRAL
  COLD_CALL
  EMAIL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  UNQUALIFIED
}

enum AddressKind {
  BILLING
  SHIPPING
  OTHER
}

model Company {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  website   String?
  industry  String?
  size      String?
  gstin     String?
  ownerId   String?
  notes     String?  @db.Text
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User?           @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts           Contact[]
  addresses          Address[]
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  quotationLinks     QuotationLink[]
  invoiceLinks       InvoiceLink[]
  tags               Tag[]           @relation("CompanyTags")
  convertedFromLeads Lead[]          @relation("LeadConvertedCompany")

  @@index([orgId, archived])
  @@index([orgId, ownerId])
  @@index([orgId, name])
}

model Address {
  id         String      @id @default(cuid())
  orgId      String
  companyId  String
  kind       AddressKind @default(OTHER)
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orgId])
}

model Contact {
  id        String      @id @default(cuid())
  orgId     String
  name      String
  title     String?
  email     String?
  phone     String?
  whatsapp  String?
  companyId String?
  source    LeadSource?
  ownerId   String?
  notes     String?     @db.Text
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              User?           @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  quotationLinks     QuotationLink[]
  tags               Tag[]           @relation("ContactTags")
  convertedFromLeads Lead[]          @relation("LeadConvertedContact")

  @@index([orgId, archived])
  @@index([orgId, ownerId])
  @@index([orgId, email])
  @@index([companyId])
}

model Lead {
  id             String     @id @default(cuid())
  orgId          String
  name           String
  companyName    String?
  email          String?
  phone          String?
  whatsapp       String?
  website        String?
  source         LeadSource @default(MANUAL)
  industry       String?
  location       String?
  ownerId        String?
  status         LeadStatus @default(NEW)
  estimatedValue Decimal?   @db.Decimal(14, 2)
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  archived       Boolean    @default(false)

  convertedAt        DateTime?
  convertedContactId String?
  convertedCompanyId String?
  convertedDealId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner            User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedContact Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedCompany Company?     @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedDeal    Deal?        @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  tasks            Task[]
  activities       Activity[]
  tags             Tag[]        @relation("LeadTags")

  @@index([orgId, archived])
  @@index([orgId, status])
  @@index([orgId, ownerId])
  @@index([orgId, createdAt])
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads     Lead[]       @relation("LeadTags")
  contacts  Contact[]    @relation("ContactTags")
  companies Company[]    @relation("CompanyTags")
  deals     Deal[]       @relation("DealTags")

  @@unique([orgId, name])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Sales Pipeline (Phase 3): Pipeline, PipelineStage, Deal, Task, Activity.
//   - Activity is the single timeline primitive. A NOTE-type activity with
//     source MANUAL is a hand-written note; SYSTEM activities record stage
//     changes, task completions, conversions, etc.
//   - Deal.status is denormalised from its stage's kind for fast filtering.
// ---------------------------------------------------------------------------

enum StageKind {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  FOLLOW_UP
  DEMO
  NOTE
  TASK
}

enum ActivitySource {
  MANUAL
  SYSTEM
}

model Pipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@index([orgId, archived])
}

model PipelineStage {
  id          String    @id @default(cuid())
  orgId       String
  pipelineId  String
  name        String
  position    Int
  probability Int       @default(0)
  kind        StageKind @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@index([orgId])
}

model Deal {
  id                String      @id @default(cuid())
  orgId             String
  name              String
  pipelineId        String
  stageId           String
  status            DealStatus  @default(OPEN)
  companyId         String?
  contactId         String?
  ownerId           String?
  value             Decimal?    @db.Decimal(14, 2)
  currency          String      @default("USD")
  probability       Int?
  source            LeadSource?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  winReason         String?
  lossReason        String?
  archived          Boolean     @default(false)
  lastActivityAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          PipelineStage   @relation(fields: [stageId], references: [id])
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner          User?           @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  activities     Activity[]
  quotationLinks QuotationLink[]
  invoiceLinks   InvoiceLink[]
  tags           Tag[]           @relation("DealTags")
  fromLeads      Lead[]          @relation("LeadConvertedDeal")

  @@index([orgId, archived])
  @@index([orgId, status])
  @@index([orgId, ownerId])
  @@index([pipelineId, stageId])
  @@index([orgId, expectedCloseDate])
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdById String?
  leadId      String?
  contactId   String?
  companyId   String?
  dealId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee  User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, assigneeId, status])
  @@index([orgId, dueAt])
  @@index([dealId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
}

model Activity {
  id          String         @id @default(cuid())
  orgId       String
  type        ActivityType
  source      ActivitySource @default(MANUAL)
  subject     String?
  body        String?        @db.Text
  occurredAt  DateTime       @default(now())
  createdById String?
  leadId      String?
  contactId   String?
  companyId   String?
  dealId      String?
  createdAt   DateTime       @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
}

// ---------------------------------------------------------------------------
// Revenue integration (Phase 4): Dotnapps Invoice link records.
//   - CRM never computes financial figures. QuotationLink / InvoiceLink /
//     PaymentEvent mirror values the provider is authoritative for, keyed by
//     the provider's `externalId`. `raw` keeps the last provider payload.
//   - Writes come from user-initiated provider calls or verified webhooks;
//     both are idempotent on `externalId`.
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  DOTNAPPS_INVOICE
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
  DISABLED
}

enum IntegrationMode {
  LIVE
  MOCK
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  CHEQUE
  UPI
  OTHER
}

enum IntegrationEventStatus {
  PROCESSED
  IGNORED
  FAILED
}

model Integration {
  id                      String              @id @default(cuid())
  orgId                   String
  provider                IntegrationProvider @default(DOTNAPPS_INVOICE)
  status                  IntegrationStatus   @default(NOT_CONFIGURED)
  mode                    IntegrationMode     @default(MOCK)
  baseUrl                 String?
  // AES-256-GCM ciphertext; never stored or logged in plaintext.
  apiKeyCiphertext        String?
  webhookSecretCiphertext String?
  advanceStageOnAccept    Boolean             @default(true)
  lastCheckedAt           DateTime?
  lastError               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

model QuotationLink {
  id         String              @id @default(cuid())
  orgId      String
  provider   IntegrationProvider @default(DOTNAPPS_INVOICE)
  externalId String
  number     String?
  status     QuotationStatus     @default(DRAFT)
  amount     Decimal?            @db.Decimal(14, 2)
  currency   String              @default("USD")
  issueDate  DateTime?
  expiryDate DateTime?
  url        String?
  dealId     String?
  companyId  String?
  contactId  String?
  raw        Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal     Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company  Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices InvoiceLink[]

  @@unique([orgId, provider, externalId])
  @@index([orgId, status])
  @@index([dealId])
  @@index([companyId])
}

model InvoiceLink {
  id              String              @id @default(cuid())
  orgId           String
  provider        IntegrationProvider @default(DOTNAPPS_INVOICE)
  externalId      String
  number          String?
  status          InvoiceStatus       @default(DRAFT)
  amount          Decimal?            @db.Decimal(14, 2)
  amountPaid      Decimal             @default(0) @db.Decimal(14, 2)
  balance         Decimal?            @db.Decimal(14, 2)
  currency        String              @default("USD")
  issueDate       DateTime?
  dueDate         DateTime?
  url             String?
  dealId          String?
  companyId       String?
  quotationLinkId String?
  raw             Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal          Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  quotationLink QuotationLink? @relation(fields: [quotationLinkId], references: [id], onDelete: SetNull)
  payments      PaymentEvent[]

  @@unique([orgId, provider, externalId])
  @@index([orgId, status])
  @@index([dealId])
  @@index([companyId])
}

model PaymentEvent {
  id            String              @id @default(cuid())
  orgId         String
  provider      IntegrationProvider @default(DOTNAPPS_INVOICE)
  externalId    String
  invoiceLinkId String
  amount        Decimal             @db.Decimal(14, 2)
  currency      String              @default("USD")
  method        PaymentMethod?
  reference     String?
  paidAt        DateTime
  raw           Json?
  createdAt     DateTime            @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice InvoiceLink  @relation(fields: [invoiceLinkId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, externalId])
  @@index([orgId, paidAt])
  @@index([invoiceLinkId])
}

model IntegrationEvent {
  id         String                 @id @default(cuid())
  orgId      String
  provider   IntegrationProvider    @default(DOTNAPPS_INVOICE)
  eventType  String
  externalId String
  status     IntegrationEventStatus @default(PROCESSED)
  error      String?
  payload    Json?
  receivedAt DateTime               @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, eventType, externalId])
  @@index([orgId, receivedAt])
}

// ---------------------------------------------------------------------------
// Rule-based automation (Phase 5) — NO AI. Explicit condition/action rules.
//   - Every fired rule writes a ReminderExecution; a unique (ruleId,dedupeKey)
//     makes re-runs idempotent.
//   - Actions produce Tasks and/or Notifications. Failures are retryable.
// ---------------------------------------------------------------------------

enum RuleTrigger {
  LEAD_CREATED_NO_FOLLOWUP
  QUOTATION_SENT_NO_RESPONSE
  DEAL_CLOSE_APPROACHING
  TASK_OVERDUE
  DEAL_STAGE_CHANGED
}

enum RuleAction {
  CREATE_TASK
  NOTIFY_OWNER
  NOTIFY_ASSIGNEE
  NOTIFY_MANAGERS
}

enum ExecutionStatus {
  DONE
  FAILED
  SKIPPED
}

model ReminderRule {
  id          String      @id @default(cuid())
  orgId       String
  name        String
  trigger     RuleTrigger
  action      RuleAction
  enabled     Boolean     @default(true)
  // { delayMinutes?, withinDays?, taskTitle?, taskPriority?, assignTo?,
  //   notifyManagers? } — validated in application code.
  config      Json        @default("{}")
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  executions ReminderExecution[]

  @@index([orgId, enabled])
}

model ReminderExecution {
  id           String          @id @default(cuid())
  orgId        String
  ruleId       String
  dedupeKey    String
  status       ExecutionStatus
  targetType   String?
  targetId     String?
  error        String?
  resultTaskId String?
  createdAt    DateTime        @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dedupeKey])
  @@index([orgId, createdAt])
  @@index([status])
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  TASK_OVERDUE
  STAGE_CHANGE
  CLOSE_APPROACHING
  AUTOMATION_FOLLOWUP
  GENERIC
}

model Notification {
  id         String           @id @default(cuid())
  orgId      String
  userId     String
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  url        String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([orgId, createdAt])
}

model NotificationPreference {
  id           String             @id @default(cuid())
  orgId        String
  userId       String
  emailEnabled Boolean            @default(false)
  mutedTypes   NotificationType[] @default([])
  updatedAt    DateTime           @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation("UserNotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ---------------------------------------------------------------------------
// SaaS subscriptions & usage (Phase 7).
//   - Plans are platform-level and configurable (no plan names hardcoded in
//     app logic — `limits` JSON drives entitlement checks).
//   - Every org has exactly one Subscription. Enforcement is server-side.
//   - There is no real payment provider wired; lifecycle transitions come
//     from the date-driven job or explicit admin actions.
// ---------------------------------------------------------------------------

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELED
}

model SubscriptionPlan {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  priceCents  Int          @default(0)
  currency    String       @default("USD")
  interval    PlanInterval @default(MONTHLY)
  trialDays   Int          @default(14)
  isPublic    Boolean      @default(true)
  isDefault   Boolean      @default(false)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  // { users?, leads?, contacts?, companies?, deals?, automationRules?,
  //   integrations?, exportsPerMonth? } — absent/null means unlimited.
  limits      Json         @default("{}")
  features    String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([isPublic, active])
}

model Subscription {
  id                 String             @id @default(cuid())
  orgId              String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  failedPaymentCount Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  org  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
}

model UsageRecord {
  id          String   @id @default(cuid())
  orgId       String
  metric      String
  quantity    Int      @default(1)
  periodStart DateTime
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, metric, periodStart])
}

