# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Dotnapps CRM targets PostgreSQL in every
# environment (see product spec, "Real authentication and persistent
# database storage").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dotnapps_crm?schema=public"

# --- Auth.js -------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app. Required in production; inferred in dev.
AUTH_URL="http://localhost:3000"
# Trust the host header (needed for local dev / preview environments).
AUTH_TRUST_HOST="true"

# --- App --------------------------------------------------------------------
# Public base URL, used when rendering absolute links (e.g. team invites).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
